# Optional .htaccess file for Apache web servers
# This ensures proper access to update files

# Allow access to this directory
Options -Indexes
<Files "update_manifest.txt">
    Order Allow,Deny
    Allow from all
</Files>

<Files "*.exe">
    Order Allow,Deny
    Allow from all
</Files>

<Files "*.txt">
    Order Allow,Deny
    Allow from all
</Files>

# Set proper MIME types
AddType text/plain .txt
AddType application/octet-stream .exe

# Enable compression to save bandwidth
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/plain "access plus 5 minutes"
</IfModule>
